/* TRAINING GROUNDS (RangeView.cs) - src/client/range.css ported rule for rule to USS, the same rg-* names (zu.uss's
   conventions: skewX is a Shape's --skew, the panel gradient a generated texture, grids are flex rows, gap is margins,
   <small> runs are rich-text <size> tags in the C#). The Hero Range meter, the spar scoreboard + countdown, prompts,
   the console. */

/* ---- the damage meter, right side under the kill feed */
.rg-meter { position: absolute; right: 24px; top: 210px; width: 330px; display: none; background-color: rgba(10, 14, 24, 0.78); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); border-left-width: 3px; border-left-color: #9fe0ff; padding: 10px 14px 8px 14px; -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; }
.rg-meter.on { display: flex; }
.rg-meter .rg-h4 { flex-direction: row; align-items: center; margin-bottom: 8px; }
.rg-meter .rg-pimg { width: 40px; height: 40px; background-position-y: top; border-width: 1px; margin-right: 10px; }
.rg-meter .rg-b { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 16px; }
.rg-meter .rg-sub { flex-direction: row; flex-wrap: wrap; }
.rg-meter .rg-small { font-size: 12px; letter-spacing: 1px; opacity: 0.8; margin-right: 6px; }
.rg-meter .rg-small.attack { color: #ff7d8a; opacity: 1; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.rg-meter .rg-small.defense { color: #7fd8ff; opacity: 1; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.rg-meter .rg-hpb { height: 10px; --fill: rgba(0, 0, 0, 0.5); --stroke: rgba(255, 255, 255, 0.14); }
.rg-meter .rg-hpn { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 15px; margin: 3px 0 2px 0; }
.rg-meter .rg-h5 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 11px; letter-spacing: 1.5px; margin: 9px 0 3px 0; opacity: 0.85; }
.rg-meter .rg-table { width: 100%; }
.rg-meter .rg-tr { flex-direction: row; align-items: center; }
.rg-meter .rg-th { width: 26%; flex-shrink: 0; -unity-font: url("Fonts/Orbitron-600.ttf"); -unity-font-definition: initial; font-size: 10px; letter-spacing: 0.8px; opacity: 0.6; padding: 2px 0; }
.rg-meter .rg-td { flex-grow: 1; flex-basis: 0; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 15px; padding: 2px 6px 2px 0; }
.rg-meter .rg-td.crit { color: #ffd76a; }
.rg-meter .rg-td.live { color: #58ffb0; }
.rg-meter .rg-keys { flex-direction: row; align-items: center; margin-top: 6px; font-size: 12px; opacity: 0.6; }
.rg-meter .rg-keys .kbd { min-width: 0; font-size: 10px; padding: 1px 5px; margin-right: 6px; }

/* ---- the spar scoreboard, top centre (in place of the objective bar), and the countdown */
.rg-spar { position: absolute; top: 64px; left: 50%; translate: -50% 0; display: none; }
.rg-spar.on { display: flex; flex-direction: row; align-items: center; }
.rg-spar .rg-side { flex-direction: row; align-items: center; padding: 6px 12px; margin: 0 5px; --fill: rgba(0, 0, 0, 0.55); --stroke: rgba(255, 255, 255, 0.14); --skew: -14; }
.rg-spar .rg-sb { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 14px; margin: 0 4px; }
.rg-spar .rg-em { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 26px; margin: 0 4px; }
.rg-spar .rg-pips { flex-direction: row; margin: 0 4px; }
.rg-spar .rg-pip { width: 10px; height: 10px; margin: 0 2px; border-width: 1px; border-color: rgba(255, 255, 255, 0.5); rotate: 45deg; }
.rg-spar .rg-mid { min-width: 240px; margin: 0 5px; align-items: center; background-color: rgba(0, 0, 0, 0.6); border-width: 1px; border-color: #3fa9ff; padding: 6px 14px; }
.rg-spar .rg-mid.done { border-color: #ffd76a; }
.rg-spar .rg-ms { -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; font-size: 11px; letter-spacing: 1.5px; opacity: 0.75; -unity-text-align: upper-center; }
.rg-spar .rg-mt { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 16px; -unity-text-align: upper-center; }
.rg-count { position: absolute; left: 0; top: 0; right: 0; bottom: 0; align-items: center; justify-content: center; opacity: 0; transition-property: opacity; transition-duration: 0.15s; }
.rg-count.on { opacity: 0.95; }
.rg-count .rg-cm { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 140px; color: #bfe6ff; text-shadow: 0 4px 40px #3fa9ff; -unity-text-align: middle-center; }
.rg-count.fight .rg-cm { color: #ffffff; font-size: 110px; letter-spacing: 9px; }
.rg-count.msg .rg-cm { font-size: 84px; }
.rg-count .rg-cs { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 28px; letter-spacing: 4px; margin-top: 12px; color: #bfe6ff; text-shadow: 0 2px 20px #3fa9ff; -unity-text-align: middle-center; }
.rg-count.win .rg-cm, .rg-count.win .rg-cs { color: #b8ffd9; text-shadow: 0 4px 40px #19c27a; }
.rg-count.lose .rg-cm, .rg-count.lose .rg-cs { color: #ffc2c8; text-shadow: 0 4px 40px #d8263d; }

/* ---- prompt, centre-low */
.rg-prompt { position: absolute; left: 50%; bottom: 210px; translate: -50% 0; display: none; background-color: rgba(0, 0, 0, 0.6); border-width: 1px; border-color: #3fa9ff; padding: 8px 18px; }
.rg-prompt.on { display: flex; flex-direction: row; align-items: center; }
.rg-prompt .kbd { min-width: 0; margin-right: 6px; }
.rg-prompt .rg-pt { -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; font-size: 16px; letter-spacing: 1.3px; }

/* ---- the console */
.rg-console { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(4, 8, 16, 0.72); align-items: center; justify-content: center; }
.rg-console .rg-box { width: 94%; max-width: 1280px; height: 90%; max-height: 780px; border-width: 1px; border-color: #3fa9ff; overflow: hidden; }
.rg-console .rg-tabs { flex-direction: row; align-items: center; padding: 0 16px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.rg-console .zb.rg-tab { --cut: 0; --fill: rgba(0, 0, 0, 0); --stroke: rgba(0, 0, 0, 0); border-bottom-width: 3px; border-color: rgba(0, 0, 0, 0); padding: 14px 20px 11px 20px; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 15px; letter-spacing: 2px; opacity: 0.6; }
.rg-console .zb.rg-tab:hover { translate: 0 0; opacity: 0.9; --fill: rgba(0, 0, 0, 0); }
.rg-console .zb.rg-tab.on { opacity: 1; color: #7fd8ff; border-bottom-color: #3fa9ff; }
.rg-console .rg-hint { flex-grow: 1; -unity-text-align: middle-right; opacity: 0.5; font-size: 14px; letter-spacing: 1.4px; margin-right: 12px; }
.rg-console .zb.rg-x { --cut: 0; opacity: 0.8; padding: 8px 14px; }
.rg-console .rg-body { flex-grow: 1; flex-direction: row; padding: 16px 20px; overflow: hidden; }
.rg-console .rg-left { flex-grow: 1; flex-basis: 0; min-width: 0; margin-right: 20px; }
.rg-console .rg-grid { flex-grow: 0; flex-shrink: 0; }
.rg-console .rg-log { flex-grow: 1; min-height: 0; margin-top: 14px; }
.rg-console .rg-opts { width: 380px; flex-shrink: 0; }
.rg-console .rg-opts .unity-scroll-view__content-container { padding-right: 4px; }
.rg-console .rg-row { flex-direction: row; margin-bottom: 8px; }
.rg-console .zb.rg-card { width: 11.4%; margin-right: 1%; padding: 0; --cut: 0; --fill: #111111; --stroke: rgba(0, 0, 0, 0); border-width: 2px; border-color: rgba(0, 0, 0, 0); overflow: hidden; justify-content: flex-end; align-items: flex-start; }
.rg-console .zb.rg-card:hover { translate: 0 -2px; }
.rg-console .rg-card .rg-cimg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-position-y: top; opacity: 0.9; }
.rg-console .rg-card .rg-cglow { position: absolute; left: 0; right: 0; bottom: 0; height: 40%; }
.rg-console .rg-card .rg-cb { position: absolute; left: 5px; bottom: 16px; font-size: 14px; letter-spacing: 0; text-shadow: 0 2px 4px #000000; }
.rg-console .rg-card .rg-crole { position: absolute; left: 5px; bottom: 3px; font-size: 10px; letter-spacing: 1px; opacity: 0.8; }
.rg-console .rg-label { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 12px; letter-spacing: 2px; opacity: 0.75; margin: 12px 0 6px 0; }
.rg-console .rg-chips { flex-direction: row; flex-wrap: wrap; }
.rg-console .rg-chips.dis { opacity: 0.3; }
.rg-console .zb.rg-chip { padding: 8px 14px; font-size: 14px; margin: 0 6px 6px 0; }
.rg-console .zb.rg-chip.on { --fill: #3fa9ff; --stroke: #3fa9ff; color: #04101e; }
.rg-console .rg-desc { margin-top: 6px; font-size: 14px; opacity: 0.72; -unity-font: url("Fonts/Rajdhani-500.ttf"); -unity-font-definition: initial; white-space: normal; }
.rg-console .rg-go { margin-top: 18px; }
.rg-console .rg-go > .zb { margin-bottom: 8px; }
.rg-console .rg-log .rg-h5 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 13px; letter-spacing: 1.8px; margin-bottom: 6px; opacity: 0.85; }
.rg-console .rg-ltable { width: 100%; }
.rg-console .rg-ltr { flex-direction: row; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.rg-console .rg-ltd { flex-grow: 1; flex-basis: 0; padding: 4px 6px; font-size: 14px; -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; }
.rg-console .rg-lth { border-color: rgba(255, 255, 255, 0.14); }
.rg-console .rg-lth .rg-ltd { -unity-font: url("Fonts/Orbitron-600.ttf"); -unity-font-definition: initial; font-size: 10px; letter-spacing: 0.8px; opacity: 0.6; }
.rg-console .rg-ltd.won { color: #58ffb0; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.rg-console .rg-ltd.lost { color: #ff5d6d; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.rg-console .rg-empty { opacity: 0.55; white-space: normal; }
