/* ZENITH//UMBRA's stylesheet - src/client/style.css ported rule for rule to USS (same class names: the C# in
   Assets/ZU/Game/UI/Toolkit builds the screens with them). What USS lacks is done elsewhere: skewX / clip-path /
   conic-gradient are drawn (Shapes.cs, from the --fill / --fill2 / --stroke / --skew / --cut properties set here),
   gradients are generated textures, filters and keyframe animations are set from code, grid layouts are flex rows,
   `gap` is margins. Fonts: the PC game's Orbitron and Rajdhani weights as separate files (USS has no font-weight). */

/* ---------------- :root, page, buttons */
.zu { color: #eef2ff; font-size: 16px; -unity-font: url("Fonts/Rajdhani-500.ttf"); -unity-font-definition: initial; position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.t { margin: 0; padding: 0; white-space: normal; }
.img { background-size: cover; background-position-x: center; background-position-y: center; }
.zb { -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; font-size: 18px; letter-spacing: 2.2px; color: #eef2ff; padding: 12px 26px; --cut: 10; --fill: rgba(255, 255, 255, 0.06); --stroke: rgba(255, 255, 255, 0.14);
  justify-content: center; align-items: center; transition-property: translate, opacity; transition-duration: 0.15s; }
.zb:hover { --fill: rgba(255, 255, 255, 0.16); translate: 4px 0; }
.zb:disabled { opacity: 0.4; }
.zb .zb-label { margin: 0; padding: 0; -unity-text-align: middle-center; white-space: normal; }
.zb.primary { --fill: #ffb347; --fill2: #ffd76a; --stroke: rgba(0, 0, 0, 0); color: #1a1206; }
.zb.primary:hover { --fill: #ffbf5f; --fill2: #ffe08a; }
.kbd { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 12px; background-color: #1b2233; border-width: 1px; border-color: #334; padding: 3px 7px; border-radius: 4px; min-width: 52px; -unity-text-align: middle-center; flex-shrink: 0; }

/* ---------------- HUD */
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.hud .bars, .hud .nums { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.cross { position: absolute; left: 50%; top: 50%; width: 240px; height: 240px; translate: -50% -50%; }
.hitmark { position: absolute; left: 50%; top: 50%; width: 30px; height: 30px; translate: -50% -50%; opacity: 0; }
.hp { position: absolute; left: 40px; bottom: 40px; width: 360px; transform-origin: left bottom; }
.hp .bar { height: 18px; --fill: rgba(0, 0, 0, 0.5); --stroke: rgba(255, 255, 255, 0.14); --skew: -18; }
.hp .num { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 34px; margin-top: 4px; }
.portrait { position: absolute; left: 40px; bottom: 120px; flex-direction: row; align-items: center; transform-origin: left bottom; }
.portrait .pimg { width: 64px; height: 64px; border-width: 2px; margin-right: 10px; background-position-y: top; }
.portrait .pname { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 20px; }
.portrait .ptitle { font-size: 14px; opacity: 0.8; }
.abil { position: absolute; right: 180px; bottom: 36px; flex-direction: row; transform-origin: right bottom; }
.hud .ab { width: 78px; height: 70px; margin-right: 10px; overflow: hidden; --fill: rgba(0, 0, 0, 0.55); --stroke: rgba(255, 255, 255, 0.14); --skew: -12; }
.hud .ab .k { position: absolute; top: 6px; left: 0; right: 0; -unity-text-align: upper-center; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 18px; }
.hud .ab .n { position: absolute; bottom: 4px; left: 0; right: 0; -unity-text-align: upper-center; font-size: 11px; letter-spacing: 0.44px; opacity: 0.85; white-space: nowrap; }
.hud .ab.ready { --stroke: rgba(255, 255, 255, 0.6); }
.hud .ab.counter.ready { --stroke: #ffd76a; --stroke-width: 2; }
.ult { position: absolute; right: 70px; bottom: 30px; width: 100px; height: 100px; transform-origin: right bottom; }
.ult .ring { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ult .v { position: absolute; left: 0; top: 0; right: 0; bottom: 0; -unity-text-align: middle-center; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 26px; }
.ult .n { position: absolute; top: 104px; width: 180px; left: -40px; -unity-text-align: upper-center; font-size: 13px; opacity: 0.8; }
.ult.ready .v { color: #ffd76a; text-shadow: 0 0 12px #ffd76a; }
.ult.active .v { color: #ffd76a; font-size: 24px; }
.ult.active .n { color: #ffd76a; opacity: 1; }
.ammo { position: absolute; right: 60px; bottom: 170px; transform-origin: right bottom; }
.ammo .ammo-t { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 38px; -unity-text-align: upper-right; }
.flight { position: absolute; left: 50%; bottom: 90px; translate: -50% 0; align-items: center; transform-origin: center bottom; }
.flight .fl-t { font-size: 12px; letter-spacing: 2.4px; -unity-text-align: upper-center; }
.flight .sw { margin-top: 3px; opacity: 0.5; font-size: 11px; letter-spacing: 2.2px; -unity-text-align: upper-center; }
.flight .sw.on { opacity: 1; color: #bfe8ff; }
.flight .fb { width: 160px; height: 6px; background-color: rgba(255, 255, 255, 0.15); margin-bottom: 4px; }
.flight .fbi { width: 100%; background-color: #bfe8ff; }
.obj { position: absolute; top: 18px; left: 50%; translate: -50% 0; flex-direction: row; align-items: center; transform-origin: center top; }
.obj .side { width: 140px; height: 16px; margin: 0 5px; --fill: rgba(0, 0, 0, 0.5); --skew: -20; }
.obj .side .sb { position: absolute; top: 18px; left: 0; font-size: 14px; }
.obj .mid { min-width: 200px; margin: 0 5px; background-color: rgba(0, 0, 0, 0.55); padding: 8px 14px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); align-items: center; }
.obj .mid-t { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 16px; -unity-text-align: upper-center; }
.obj .mid-s { -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 13px; opacity: 0.7; -unity-text-align: upper-center; }
.obj .mid.us { border-color: #5cc8ff; }
.obj .mid.them { border-color: #ff3b5c; }
.obj .mid.ot { border-color: #ffcc33; color: #ffcc33; }
.obj .pips { flex-direction: row; margin: 0 5px; }
.obj .pip { width: 14px; height: 14px; margin: 0 2.5px; border-width: 2px; border-color: rgba(255, 255, 255, 0.5); rotate: 45deg; background-color: rgba(0, 0, 0, 0.4); }
.obj .pip.z { background-color: #5cc8ff; border-color: #5cc8ff; }
.obj .pip.u { background-color: #ff3b5c; border-color: #ff3b5c; }
.obj .push { align-items: center; }
.obj .push .trk { width: 460px; height: 12px; background-color: rgba(0, 0, 0, 0.55); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); margin-bottom: 6px; }
.obj .push .mk { position: absolute; top: -3px; bottom: -3px; width: 3px; margin-left: -1.5px; }
.obj .push .mk.c { left: 50%; background-color: rgba(255, 255, 255, 0.5); }
.obj .push .mk.bu { background-color: #5cc8ff; }
.obj .push .mk.bt { background-color: #ff3b5c; }
.obj .push .fl { position: absolute; top: 50%; width: 18px; height: 18px; margin-top: -9px; margin-left: -9px; rotate: 45deg; background-color: #e8b64a; border-width: 2px; border-color: #fff; transition-property: left; transition-duration: 0.2s; transition-timing-function: linear; }
.obj .push .fl.us { background-color: #5cc8ff; }
.obj .push .fl.them { background-color: #ff3b5c; }
.obj .push .fl.con { background-color: #ffcc33; }
.bossbar { width: 760px; align-items: center; }
.bossbar .bb-n { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 22px; letter-spacing: 2.2px; -unity-text-align: upper-center; }
.bossbar .bb-t { font-size: 13px; letter-spacing: 3.9px; opacity: 0.8; -unity-text-align: upper-center; }
.bossbar .bb-bar { width: 100%; height: 12px; margin-top: 6px; background-color: rgba(0, 0, 0, 0.6); border-width: 1px; }
.bossbar .bb-fill { height: 100%; transition-property: width; transition-duration: 0.2s; }
.bossbar .bb-w { font-size: 13px; color: #ffd76a; -unity-text-align: upper-center; }
.feed { position: absolute; right: 24px; top: 20px; align-items: flex-end; transform-origin: right top; }
.kf { background-color: rgba(0, 0, 0, 0.55); padding: 4px 6px; margin-bottom: 4px; flex-direction: row; font-size: 15px; }
.kf .kf-b, .kf .kf-i { margin: 0 4px; }
.kf.me { border-width: 1px; border-color: #ffd76a; }
.callout { position: absolute; top: 90px; left: 50%; translate: -50% 0; align-items: center; transform-origin: center top; }
.co { padding: 6px 60px; margin-bottom: 6px; align-items: center; border-top-width: 1px; border-bottom-width: 1px; transition-property: scale, opacity; transition-duration: 0.25s; }
.co.out { opacity: 0; transition-duration: 0.5s; }
.co .co-k { color: #ffd76a; letter-spacing: 4.8px; font-size: 12px; -unity-text-align: upper-center; }
.co .co-b { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 20px; -unity-text-align: upper-center; }
.co .co-s { font-size: 13px; opacity: 0.7; -unity-text-align: upper-center; }
.msg { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 22px; text-shadow: 0 2px 8px #000; margin-bottom: 6px; -unity-text-align: upper-center; transition-property: scale, opacity; transition-duration: 0.25s; }
.banner { position: absolute; top: 40%; left: 50%; translate: -50% -50%; align-items: center; }
.banner .b { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 40px; color: #ff3b5c; -unity-text-align: upper-center; }
.banner .s { font-size: 20px; -unity-text-align: upper-center; }
.hud.spectate .banner { top: auto; bottom: 30px; translate: -50% 0; background-color: rgba(0, 0, 0, 0.5); padding: 8px 20px; }
.hud.spectate .banner .s { font-size: 15px; }
.hud.spectate .hp, .hud.spectate .abil, .hud.spectate .ult, .hud.spectate .ammo, .hud.spectate .portrait, .hud.spectate .cross, .hud.spectate .flight { display: none; }
.status { position: absolute; left: 50%; bottom: 130px; translate: -50% 0; flex-direction: row; transform-origin: center bottom; }
.status .chip { border-width: 1px; padding: 2px 8px; margin: 0 3px; font-size: 13px; background-color: rgba(0, 0, 0, 0.5); }
.board { position: absolute; left: 50%; top: 50%; translate: -50% -50%; background-color: rgba(10, 14, 24, 0.78); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 20px 30px; min-width: 640px; }
.board.ow2 { min-width: 980px; padding: 18px 24px; background-color: rgba(8, 10, 18, 0.9); }
.board .h2 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 28px; -unity-text-align: upper-center; margin-bottom: 10px; }
.board .h2.win { color: #5cffa7; }
.board .h2.loss { color: #ff5d7a; }
.board .hdr { flex-direction: row; justify-content: space-between; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 15px; letter-spacing: 1.2px; padding-bottom: 10px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.14); margin-bottom: 8px; }
.board .hdr-b { color: #ffd76a; }
.board .teams { flex-direction: row; }
.board .tm { flex-grow: 1; flex-basis: 0; margin: 0 9px; }
.board .tm .h3 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 16px; margin: 10px 0 4px 0; }
.board .tm.mine .h3 { color: #5cc8ff; }
.board .tm.enemy .h3 { color: #ff3b5c; }
.board .tr { flex-direction: row; align-items: center; padding: 3px 0; }
.board .tr.me { background-color: rgba(255, 215, 106, 0.12); }
.board .tr.dead { opacity: 0.45; }
.board .td { width: 58px; padding: 0 8px; font-size: 15px; -unity-text-align: middle-right; }
.board .td.h { flex-grow: 1; width: auto; flex-direction: row; align-items: center; -unity-text-align: middle-left; }
.board .th .td { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 12px; opacity: 0.7; }
.board .ti { width: 24px; height: 24px; margin-right: 6px; background-position-y: top; }
.board .tn { font-size: 15px; }
.board .u, .board .up { margin-left: auto; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 11px; opacity: 0.75; padding-left: 6px; }
.board .u { color: #ffd76a; opacity: 1; }
.board .mine { flex-direction: row; align-items: center; margin-top: 12px; padding-top: 12px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.board .who { align-items: center; min-width: 120px; margin-right: 18px; }
.board .who-img { width: 64px; height: 64px; background-position-y: top; }
.board .who-s { opacity: 0.6; }
.board .tiles { flex-grow: 1; flex-direction: row; flex-wrap: wrap; }
.board .tile { width: 24%; margin: 0.5%; background-color: rgba(255, 255, 255, 0.05); padding: 6px 10px; }
.board .tile-k { font-size: 12px; opacity: 0.6; letter-spacing: 0.7px; }
.board .tile-v { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 18px; }
.board .shots { position: absolute; right: 0; bottom: -18px; font-size: 12px; opacity: 0.5; }
.fps { position: absolute; left: 10px; top: 8px; font-size: 12px; opacity: 0.6; }
.fps.adv { -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; -unity-text-align: upper-right; background-color: rgba(0, 0, 0, 0.45); padding: 6px 8px; opacity: 1; }
.ob { position: absolute; left: 0; top: 0; width: 90px; margin-left: -45px; align-items: center; transform-origin: 50% 100%; }
.ob .ob-n { font-size: 12px; text-shadow: 0 1px 3px #000; -unity-text-align: upper-center; white-space: nowrap; }
.ob.enemy .ob-n { color: #ffb3c1; }
.ob .ob-bar { width: 100%; height: 5px; background-color: rgba(0, 0, 0, 0.6); margin-top: 2px; }
.ob .ob-fill { position: absolute; top: 0; bottom: 0; left: 0; }
.ob .ob-sh { position: absolute; top: 0; bottom: 0; left: 0; background-color: #7fd3ff; opacity: 0.8; }
.dn { position: absolute; left: 0; top: 0; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 18px; color: #fff; text-shadow: 0 2px 4px #000; white-space: nowrap; }
.dn.crit { color: #ff5252; font-size: 22px; }
.dn.heal { color: #8dff9e; }
.subs { position: absolute; left: 50%; bottom: 21%; translate: -50% 0; align-items: center; }
.subs .sub { padding: 3px 12px; margin-bottom: 4px; transition-property: opacity; transition-duration: 0.3s; }
.subs .sub-t { -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 20px; letter-spacing: 0.4px; }
.hud.nofeed .feed, .hud.nonums .nums, .hud.nohit .hitmark, .hud.nocounter .callout .co { display: none; }


/* ---------------- loading screen + preloader (Menu.ts .loading, Preload.ts showProgress) */
.loading { position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: flex-end; padding: 60px 8%; background-color: #05060a; overflow: hidden; }
.loading .bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-size: cover; }
.loading .ld-h2 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 48px; }
.loading .ld-p { max-width: 700px; font-size: 18px; color: #d5dcf5; margin: 16px 0; }
.loading .tips { opacity: 0.6; font-size: 15px; margin-top: 16px; }
.loading .mf { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 26px; letter-spacing: 7.8px; color: #ffd76a; }
.loading .obj { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 18px; letter-spacing: 1.8px; color: #fff; margin-top: 8px; }
.loading .st { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 22px; letter-spacing: 3.3px; margin-top: 16px; }
.spin { width: 40px; height: 40px; border-width: 3px; border-color: rgba(255, 255, 255, 0.2); border-top-color: #ffd76a; border-radius: 20px; margin: 8px 0; }
.preload { width: 520px; max-width: 80%; margin-top: 18px; margin-left: auto; margin-right: auto; align-items: stretch; }
.preload .pl-track { height: 6px; border-radius: 3px; background-color: rgba(255, 255, 255, 0.14); overflow: hidden; }
.preload .pl-fill { height: 100%; width: 0; transition-property: width; transition-duration: 0.2s; }
.preload .pl-label { margin-top: 8px; -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 12px; letter-spacing: 1.44px; color: #cfe8ff; -unity-text-align: upper-center; }

/* ---------------- pause / results (Menu.ts .pause) */
.pause { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(5, 6, 12, 0.72); align-items: center; justify-content: center; }
.pause .p-h2 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 42px; letter-spacing: 4.2px; margin-bottom: 24px; -unity-text-align: upper-center; }
.pause .p-h2.zenith { color: #5cc8ff; }
.pause .p-h2.umbra { color: #ff3b5c; }
.pause .p-h2.win { color: #5cffa7; }
.pause .p-h2.loss { color: #ff5d7a; }
.pause .tips { opacity: 0.6; margin-top: 14px; }
.btns { width: 320px; }
.btns > .zb { margin-bottom: 10px; }
.results .sres { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 20px; letter-spacing: 2px; color: #ffd76a; margin-bottom: 18px; -unity-text-align: upper-center; }
.mystats { flex-direction: row; margin-bottom: 14px; }
.mystats .ms { background-color: rgba(0, 0, 0, 0.45); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 10px 16px; min-width: 110px; margin: 0 6px; align-items: center; }
.mystats .ms-b { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 24px; -unity-text-align: upper-center; }
.mystats .ms-s { opacity: 0.65; letter-spacing: 1.6px; -unity-text-align: upper-center; }
.rankup { flex-direction: row; align-items: center; padding: 14px 22px; background-color: rgba(0, 0, 0, 0.45); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); margin-bottom: 14px; }
.rankup .from, .rankup .to { align-items: center; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 14px; margin: 0 13px; }
.rankup .ru-l { margin-top: 6px; -unity-text-align: upper-center; }
.rankup .mid { align-items: center; margin: 0 13px; }
.pbar { width: 100%; height: 8px; background-color: rgba(255, 255, 255, 0.12); overflow: hidden; }
.pbar > * { position: absolute; top: 0; bottom: 0; left: 0; }
.pbar.big { height: 14px; width: 360px; margin-bottom: 8px; }
.pbar .old { background-color: rgba(255, 255, 255, 0.55); }
.pbar .new.gain { background-color: #5cffa7; }
.pbar .new.loss { background-color: #ff5d7a; }
.rankup .dl { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 26px; margin-bottom: 8px; }
.rankup .dl.gain { color: #5cffa7; }
.rankup .dl.loss { color: #ff5d7a; }
.rankup .mods { flex-direction: row; flex-wrap: wrap; justify-content: center; max-width: 380px; }
.rankup .mod { -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; font-size: 12px; letter-spacing: 0.96px; padding: 3px 8px; margin: 3px; background-color: rgba(255, 215, 106, 0.15); border-width: 1px; border-color: rgba(255, 215, 106, 0.4); }
.rankup .bn { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 18px; color: #ffd76a; margin-top: 8px; }
.rankup.down .bn { color: #ff5d7a; }
.qp { opacity: 0.8; margin-bottom: 14px; }
.emblem { align-items: center; justify-content: center; }
.emblem .em-b { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; color: #fff; text-shadow: 0 2px 6px rgba(0, 0, 0, 0.8); -unity-text-align: middle-center; }

/* ---------------- Stadium Armory (Armory.ts) */
.armory { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 22px 36px; }
.armory > * { margin-bottom: 14px; }
.armory > .ar-bg { margin-bottom: 0; }
.ar-top { flex-direction: row; align-items: center; }
.ar-title { flex-grow: 1; }
.ar-title .ar-t { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 34px; letter-spacing: 4.08px; color: #ffd76a; }
.ar-title .ar-s { font-size: 16px; letter-spacing: 1.6px; opacity: 0.8; }
.ar-cash { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 30px; color: #7dff9a; margin-left: 24px; }
.ar-time { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 26px; min-width: 70px; -unity-text-align: upper-right; margin-left: 24px; }
.ar-powers .ar-h3 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 18px; letter-spacing: 2.16px; margin-bottom: 8px; }
.ar-powers .pw { flex-direction: row; }
.zb.power { flex-grow: 1; flex-basis: 0; margin-right: 10px; padding: 12px; min-height: 96px; align-items: flex-start; justify-content: flex-start; --fill: #2b1f45; --fill2: #120d1f; --stroke: #9d7bff; --stroke-width: 2; color: #fff; }
.zb.power:hover { --stroke: #ffd76a; --fill: #2b1f45; --fill2: #120d1f; }
.zb.power:disabled { opacity: 0.35; }
.power .pw-b { font-size: 16px; color: #d9c8ff; }
.power .pw-p { margin-top: 6px; font-size: 14px; opacity: 0.85; letter-spacing: 0; -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; }
.ar-main { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.ar-tabs { flex-direction: row; margin-bottom: 10px; }
.ar-tabs .ar-tab { min-width: 150px; margin-right: 8px; }
.ar-tabs .ar-tab.on { --stroke: #ffd76a; color: #ffd76a; }
.ar-scroll { flex-grow: 1; }
.ar-items { flex-direction: row; flex-wrap: wrap; align-items: flex-start; }
.zb.it { width: 220px; min-height: 120px; padding: 12px 14px; margin: 0 12px 12px 0; align-items: stretch; justify-content: flex-start; --fill: #0f1422; --stroke: #5a6479; --stroke-width: 2; color: #fff; }
.zb.it:hover { --fill: #0f1422; translate: 0 -2px; }
.zb.it:disabled { opacity: 0.4; translate: 0 0; }
.it .it-b { font-size: 17px; letter-spacing: 0; }
.it .it-s { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 11px; letter-spacing: 1.65px; opacity: 0.8; margin: 4px 0; }
.it .it-p { -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 14px; opacity: 0.85; flex-grow: 1; letter-spacing: 0; margin-bottom: 4px; }
.it .it-e { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 16px; color: #7dff9a; }
.zb.it.common { --stroke: #7dd87d; }
.zb.it.rare { --stroke: #5cb4ff; }
.zb.it.epic { --stroke: #c77dff; }
.it.common .it-s { color: #7dd87d; }
.it.rare .it-s { color: #5cb4ff; }
.it.epic .it-s { color: #c77dff; }
.zb.it.owned, .zb.it.owned:hover { --fill: #1c2a1c; }
.it.owned .it-e { color: #ffd76a; }
.ar-bottom { flex-direction: row; align-items: center; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding-top: 12px; margin-bottom: 0; }
.ar-owned { flex-grow: 1; flex-direction: row; flex-wrap: wrap; align-items: center; }
.ar-owned .ar-os { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 13px; letter-spacing: 1.3px; opacity: 0.7; margin-right: 10px; }
.ar-owned .ar-oi { padding: 4px 10px; font-size: 14px; border-width: 1px; margin-right: 6px; margin-bottom: 4px; }
.ar-owned .ar-oi.common { border-color: #7dd87d; }
.ar-owned .ar-oi.rare { border-color: #5cb4ff; }
.ar-owned .ar-oi.epic { border-color: #c77dff; }
.ar-owned .ar-oi.pow { border-color: #9d7bff; color: #d9c8ff; }
.armory .ready { min-width: 200px; font-size: 20px; padding: 14px; margin-left: 16px; }

/* ---------------- Options (SettingsUI.ts .opts) */
.opts { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.opts .o-header { flex-direction: row; align-items: flex-end; padding: 26px 48px 0 48px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.opts .o-h2 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 30px; letter-spacing: 3.6px; margin: 0 36px 12px 0; }
.opts .o-nav { flex-direction: row; }
.opts .zb.tab { --cut: 0; --fill: rgba(0, 0, 0, 0); --stroke: rgba(0, 0, 0, 0); border-bottom-width: 3px; border-color: rgba(0, 0, 0, 0); padding: 10px 22px 12px 22px; font-size: 19px; opacity: 0.65; margin-right: 4px; }
.opts .zb.tab:hover { opacity: 1; --fill: rgba(255, 255, 255, 0.05); translate: 0 0; }
.opts .zb.tab.on { opacity: 1; border-color: #ffd76a; color: #ffd76a; }
.opts .o-main { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; padding: 0 48px; }
.opts .o-list { flex-grow: 1; min-width: 560px; margin-right: 30px; }
.opts .o-list .unity-scroll-view__content-container { padding: 14px 16px 30px 0; }
.opts .o-aside { width: 360px; padding: 20px 0; }
.opts .h4 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 2.24px; color: #9fb0e6; margin: 22px 0 8px 0; padding-bottom: 6px; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.opts .o-aside .h4 { margin-top: 0; }
.opts .orow { flex-direction: row; align-items: center; padding: 6px 10px; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; letter-spacing: 0.8px; }
.opts .orow:hover { background-color: rgba(255, 255, 255, 0.05); }
.opts .orow-l { font-size: 16px; flex-grow: 1; flex-shrink: 1; margin-right: 16px; }
.opts .sel { width: 360px; flex-direction: row; align-items: center; background-color: rgba(255, 255, 255, 0.06); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.opts .zb.sel-b { --cut: 0; --stroke: rgba(0, 0, 0, 0); --fill: rgba(0, 0, 0, 0); width: 36px; padding: 6px 0; font-size: 12px; }
.opts .zb.sel-b:hover { --fill: rgba(255, 255, 255, 0.12); translate: 0 0; }
.opts .sel-v { flex-grow: 1; -unity-text-align: middle-center; font-size: 15px; letter-spacing: 1.2px; }
.opts .sld { width: 360px; flex-direction: row; align-items: center; }
.opts .sld-in { flex-grow: 1; margin: 0 12px 0 0; }
.opts .sld-in .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.18); border-color: rgba(255, 255, 255, 0.14); }
.opts .sld-in .unity-base-slider__dragger { background-color: #ffd76a; border-color: #ffd76a; }
.opts .sld-v, .opts .clr-v { width: 56px; -unity-text-align: middle-right; font-size: 15px; }
.opts .clr { width: 360px; flex-direction: row; align-items: center; }
.opts .clr-sw { flex-grow: 1; flex-direction: row; flex-wrap: wrap; }
.opts .zb.clr-c { --cut: 0; --fill: rgba(0, 0, 0, 0); --stroke: rgba(0, 0, 0, 0); width: 20px; height: 20px; padding: 0; margin: 2px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.opts .zb.clr-c:hover { translate: 0 0; border-color: #ffd76a; }
.opts .zb.clr-c.on { border-width: 2px; border-color: #ffd76a; }
.opts .keys { width: 360px; flex-direction: row; align-items: center; }
.opts .zb.key { --cut: 0; --fill: rgba(255, 255, 255, 0.07); flex-grow: 1; flex-basis: 0; padding: 7px 8px; font-size: 14px; letter-spacing: 0.84px; min-height: 34px; margin-right: 6px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); --stroke: rgba(0, 0, 0, 0); }
.opts .zb.key:hover { translate: 0 0; border-color: #ffd76a; }
.opts .zb.key.inh { opacity: 0.5; }
.opts .zb.key.listen { --fill: #ffd76a; color: #1a1206; }
.opts .zb.clr-ov { --cut: 0; width: 28px; padding: 0; font-size: 16px; --stroke: rgba(0, 0, 0, 0); }
.opts .clr-ov-gap { width: 28px; }
.opts .scope { flex-direction: row; align-items: center; margin: 16px 0 4px 0; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 1.68px; }
.opts .scope-l { margin-right: 14px; }
.opts .hsel { min-width: 240px; }
.opts .note { color: #9aa4c4; font-size: 14px; margin: 6px 0; }
.opts .rprev { width: 240px; height: 240px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); margin-bottom: 10px; }
.opts .o-footer { flex-direction: row; justify-content: flex-end; padding: 16px 48px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.14); background-color: rgba(0, 0, 0, 0.35); }
.opts .o-footer .zb { margin-left: 12px; }


/* ---------------- menu screens (Menu.ts) */
.menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.title { position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; padding-left: 8%; background-color: #05060a; overflow: hidden; }
.title .bg { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-size: cover; }
.logo { flex-direction: row; align-items: center; }
.logo .lz, .logo .li, .logo .lu { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 108px; letter-spacing: 4.3px; }
.logo .lz { color: #fff; text-shadow: 0 0 30px #5cc8ff; }
.logo .lu { color: #ff3b5c; text-shadow: 0 0 30px #ff3b5c; }
.logo .li { color: #ffd76a; margin: 0 11px; }
.title .tag { font-size: 24px; letter-spacing: 7.2px; color: #c9d2ff; margin: 10px 0 40px 0; }
.btns.two { width: auto; }
.btns.two .brow { flex-direction: row; margin-bottom: 10px; }
.btns.two .brow > .zb { width: 300px; margin-right: 10px; margin-bottom: 0; }
.ver { position: absolute; bottom: 20px; left: 8%; opacity: 0.5; font-size: 14px; letter-spacing: 1.4px; }
.m-h2 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 28px; margin-bottom: 16px; }
.bar { flex-direction: row; justify-content: flex-end; align-items: center; padding: 16px 40px; background-color: rgba(0, 0, 0, 0.5); border-top-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.bar > * { margin-left: 14px; }
.bar .qtag { margin-right: auto; margin-left: 0; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 2.1px; color: #ffd76a; }
.bar .bar-label { flex-direction: row; align-items: center; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; letter-spacing: 1.6px; }
.bar .bl { margin-right: 8px; }
.bsel, .csel, .hsel { min-width: 180px; }
.bsel .unity-base-field__input, .csel .unity-base-field__input, .hsel .unity-base-field__input { background-color: #111827; border-color: rgba(255, 255, 255, 0.14); color: #fff; -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 16px; }

/* hero select */
.select { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #05060a; }
.select .sel-top { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: row; }
.select .grid { width: 44%; min-width: 420px; }
.select .grid .unity-scroll-view__content-container { padding: 30px 30px 0 40px; }
.select .detail { flex-grow: 1; }
.select .detail .unity-scroll-view__content-container { padding: 30px 40px 0 10px; }
.s-h3 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 20px; letter-spacing: 3px; margin: 14px 0 10px 0; }
.s-h3.zenith { color: #5cc8ff; }
.s-h3.umbra { color: #ff3b5c; }
.row { flex-direction: row; flex-wrap: wrap; }
.zb.hc { width: 18%; margin: 0 1% 10px 1%; padding: 0; --cut: 0; --fill: #111; --stroke: rgba(0, 0, 0, 0); border-width: 2px; border-color: rgba(0, 0, 0, 0); overflow: hidden; justify-content: flex-end; align-items: flex-start; }
.zb.hc:hover { translate: 0 -3px; }
.hc .hc-img { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-position-y: top; }
.hc .hc-glow { position: absolute; left: 0; right: 0; bottom: 0; height: 40%; }
.hc .hc-b { position: absolute; left: 6px; bottom: 18px; font-size: 16px; text-shadow: 0 2px 4px #000; letter-spacing: 0; }
.hc .hc-s { position: absolute; left: 6px; bottom: 4px; font-size: 11px; opacity: 0.8; letter-spacing: 1.1px; }
.hd { flex-direction: row; }
.hd .art { width: 38%; min-height: 756px; margin-right: 24px; border-width: 1px; background-size: cover; background-position-y: top; flex-shrink: 0; }
.hd .info { flex-grow: 1; flex-shrink: 1; }
.hd .hd-h2 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 40px; }
.hd .hd-sub { -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 18px; color: #c9d2ff; letter-spacing: 3.6px; }
.meta { flex-direction: row; flex-wrap: wrap; margin: 10px 0; }
.meta .chip { background-color: rgba(255, 255, 255, 0.08); padding: 3px 10px; font-size: 13px; letter-spacing: 1.3px; margin: 0 8px 8px 0; }
.meta .chip.zenith { color: #5cc8ff; }
.meta .chip.umbra { color: #ff3b5c; }
.lore { color: #c3c9e0; font-size: 16px; margin: 8px 0; }
.pilot { flex-direction: row; align-items: center; background-color: rgba(255, 215, 106, 0.08); border-left-width: 3px; border-color: #ffd76a; padding: 8px; font-size: 15px; margin: 8px 0; }
.pilot .pilot-img { width: 56px; height: 56px; background-position-y: top; margin-right: 10px; flex-shrink: 0; }
.pilot .pilot-t { flex-shrink: 1; }
.hd .ab { flex-direction: row; align-items: flex-start; margin: 8px 0; }
.hd .ab .kbd { margin-right: 12px; }
.hd .ab-t { flex-shrink: 1; flex-grow: 1; }
.hd .ab-b { font-size: 17px; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.hd .ab-p { margin: 2px 0; color: #b8c0d8; font-size: 15px; }
.ab-p.ctr, .vab-p.ctr { color: #ffd76a; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.rival { margin-top: 12px; color: #c9d2ff; }

/* queues, maps, modes */
.modes { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 30px 40px 0 40px; background-color: #05060a; }
.modes .bar, .maps .bar, .campaign-menu .bar { margin: 18px -40px 0 -40px; }
.q-h3 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 16px; letter-spacing: 2.4px; margin: 18px 0 10px 0; opacity: 0.85; }
.roles, .diffs { flex-direction: row; flex-wrap: wrap; }
.zb.card { --cut: 0; --fill: #0d111c; --stroke: rgba(0, 0, 0, 0); border-width: 2px; border-color: rgba(255, 255, 255, 0.14); padding: 18px 20px; align-items: center; justify-content: flex-start; min-width: 210px; margin: 0 22px 12px 0; }
.diffs .zb.card { min-width: 180px; margin-right: 16px; }
.zb.card:hover, .zb.card.sel { translate: 0 -3px; border-color: #ffd76a; }
.card > * { margin-bottom: 8px; }
.card .c-b { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 22px; letter-spacing: 1.76px; -unity-text-align: upper-center; }
.card .c-p { opacity: 0.8; -unity-text-align: upper-center; -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 16px; letter-spacing: 0; max-width: 260px; }
.card .rl { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 16px; }
.card .rec { opacity: 0.7; font-size: 14px; }
.ri { width: 42px; height: 42px; --fill: #ffd76a; }
.ri.flex { border-radius: 21px; background-color: #ffd76a; }
.maps { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 30px 40px 0 40px; background-color: #05060a; }
.mgrid-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.mgrid { flex-direction: row; flex-wrap: wrap; }
.zb.mc { width: 18.8%; margin: 0 1.2% 14px 0; padding: 0 0 8px 0; --cut: 0; --fill: #0d111c; --stroke: rgba(0, 0, 0, 0); border-width: 2px; border-color: rgba(255, 255, 255, 0.14); align-items: stretch; justify-content: flex-start; }
.mapsq .zb.mc { width: 15.4%; }
.zb.mc:hover { translate: 0 0; border-color: rgba(255, 215, 106, 0.6); }
.zb.mc.sel { border-color: #ffd76a; }
.mc .mc-img { height: 120px; background-position-y: center; }
.mapsq .mc .mc-img, .mapsq .mc .rnd { height: 110px; }
.mc .rnd { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 60px; opacity: 0.5; -unity-text-align: middle-center; }
.mc .mc-b { padding: 6px 10px 0 10px; font-size: 18px; letter-spacing: 0; }
.mc .mc-p { padding: 0 10px; color: #aab; font-size: 14px; letter-spacing: 0; -unity-font: url("Fonts/Rajdhani-500.ttf"); -unity-font-definition: initial; }
.find .bar.find-bar { position: absolute; left: 0; right: 0; bottom: 0; }
.campaign-menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 30px 40px 0 40px; background-color: #05060a; }
.lvls { flex-direction: row; margin: 18px 0; }
.zb.lv { flex-grow: 1; flex-basis: 0; margin-right: 12px; padding: 0 0 8px 0; --cut: 0; --fill: #0d111c; --stroke: rgba(0, 0, 0, 0); border-width: 2px; border-color: rgba(255, 255, 255, 0.14); align-items: stretch; justify-content: flex-start; }
.zb.lv:hover { translate: 0 0; }
.zb.lv.sel { border-color: #ffd76a; }
.zb.lv.locked:disabled { opacity: 0.35; }
.lv .lv-img { height: 150px; }
.lv .bimg { position: absolute; right: 6px; top: 6px; width: 38%; height: 70px; border-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.lv .lv-b { padding: 6px 10px 0 10px; font-size: 17px; letter-spacing: 0; }
.lv .lv-s { padding: 0 10px; color: #aab; letter-spacing: 0; -unity-font: url("Fonts/Rajdhani-500.ttf"); -unity-font-definition: initial; font-size: 16px; }
.squad { flex-direction: row; flex-wrap: wrap; align-items: flex-start; flex-grow: 1; }
.squad .heroes { flex-direction: row; }
.squad .zb.hc { width: 100px; margin: 0 8px 0 0; }
.coop { flex-grow: 1; min-width: 320px; margin-left: 16px; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 12px 16px; }
.coop .coop-h4 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 15px; letter-spacing: 1.5px; margin-bottom: 6px; }
.coop .st { font-size: 13px; opacity: 0.7; }

/* ---------------- hero viewer (HeroViewer.ts) */
.viewer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; background-color: #05060a; }
.vlist { width: 300px; border-right-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.vlist .unity-scroll-view__content-container { padding: 18px 14px; }
.v-h3 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 1.68px; margin: 14px 0 8px 0; }
.v-h3.zenith { color: #5cc8ff; }
.v-h3.umbra { color: #ff3b5c; }
.vrow { flex-direction: row; flex-wrap: wrap; }
.zb.vchip { width: 48%; margin: 0 2% 6px 0; flex-direction: row; justify-content: flex-start; padding: 4px; --cut: 0; --fill: rgba(255, 255, 255, 0.06); --stroke: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(0, 0, 0, 0); font-size: 14px; letter-spacing: 0.3px; }
.zb.vchip:hover { translate: 0 0; --fill: rgba(255, 255, 255, 0.12); }
.zb.vchip.sel { --fill: rgba(255, 255, 255, 0.12); border-color: #ffd76a; }
.vchip .vc-img { width: 38px; height: 38px; border-width: 1px; background-position-y: top; margin-right: 8px; flex-shrink: 0; }
.vchip .vc-t { flex-shrink: 1; white-space: normal; }
.vstage { flex-grow: 1; overflow: hidden; background-size: 100% 100%; }
.vname { position: absolute; left: 24px; top: 18px; }
.vname .vn-b { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 40px; text-shadow: 0 0 20px rgba(0, 0, 0, 0.6); }
.vname .vn-s { letter-spacing: 4.8px; opacity: 0.8; }
.vanims { position: absolute; left: 4%; right: 4%; bottom: 44px; flex-direction: row; flex-wrap: wrap; justify-content: center; }
.vanims .zb.va { padding: 7px 14px; font-size: 14px; margin: 3px; }
.vanims .zb.va.on { --fill: #ffd76a; --fill2: rgba(0, 0, 0, 0); color: #1a1206; }
.vhint { position: absolute; left: 0; right: 0; bottom: 14px; -unity-text-align: upper-center; font-size: 13px; opacity: 0.55; }
.vhint.vclip { bottom: auto; top: 12px; }
.vside { width: 380px; border-left-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.vside .unity-scroll-view__content-container { padding: 18px; }
.vside .unity-scroll-view__content-container > * { margin-bottom: 12px; }
.vs-h4 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 1.68px; margin-bottom: 8px; }
.vskins .dim { opacity: 0.6; }
.zb.skin { flex-direction: row; justify-content: flex-start; padding: 6px 10px; margin-bottom: 6px; --cut: 0; --stroke: rgba(0, 0, 0, 0); font-size: 15px; letter-spacing: 0.45px; border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.zb.skin:hover { translate: 0 0; }
.zb.skin.sel { border-color: #ffd76a; }
.skin .sk-i { width: 34px; height: 34px; border-radius: 17px; border-width: 2px; border-color: rgba(255, 255, 255, 0.2); margin-right: 10px; flex-shrink: 0; }
.skin .sk-r { font-size: 11px; opacity: 0.7; letter-spacing: 1.65px; }
.skin.r-rare .sk-r { color: #5cc8ff; }
.skin.r-epic .sk-r { color: #c77dff; }
.skin.r-legendary .sk-r { color: #ffd76a; }
.vskins .equip { margin-top: 4px; }
.vinfo .vmeta { font-size: 13px; letter-spacing: 1.3px; opacity: 0.8; }
.vab { flex-direction: row; margin: 8px 0; }
.vab .kbd { margin-right: 10px; }
.vab-t { flex-shrink: 1; flex-grow: 1; }
.vab-b { -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.vab-p { margin: 2px 0; font-size: 14px; color: #b8c0d8; }

/* ---------------- results: hero levels and Hero SR (OnlineUI.progressHtml) */
.progress { flex-direction: row; margin-bottom: 14px; }
.progress .srs, .progress .lvs { margin: 0 10px; }
.progress .srch, .progress .lvup { flex-direction: row; align-items: center; background-color: rgba(0, 0, 0, 0.4); padding: 6px 10px; margin-bottom: 6px; min-width: 300px; }
.progress .srch > *, .progress .lvup > * { margin-right: 8px; }
.progress .pg-b { -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; }
.progress .pg-s { font-size: 14px; opacity: 0.85; }
.progress .lv-img { width: 34px; height: 34px; background-position-y: top; }
.progress .lv-bar { width: 80px; height: 6px; background-color: rgba(255, 255, 255, 0.12); }
.progress .lv-fill { height: 100%; background-color: #ffd76a; }

/* ---------------- career profile (career.css) */
.cp { position: absolute; left: 0; top: 0; right: 0; bottom: 0; padding: 24px 40px 0 40px; background-color: #05060a; overflow: hidden; }
.cp .head { flex-direction: row; align-items: center; }
.cp .medal { width: 74px; height: 74px; border-radius: 37px; align-items: center; justify-content: center; border-width: 3px; border-color: #ffd76a; margin-right: 18px; }
.cp .md-b { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 24px; -unity-text-align: middle-center; }
.cp .md-s { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 9px; letter-spacing: 1.8px; opacity: 0.7; -unity-text-align: upper-center; }
.cp .who-h2 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 30px; }
.cp .who-s { opacity: 0.75; letter-spacing: 0.8px; }
.cp .chips { margin-left: auto; flex-direction: row; }
.cp .chip { flex-direction: row; align-items: center; margin-left: 14px; }
.cp .chip-s { font-size: 12px; opacity: 0.85; margin-left: 6px; }
.cp .tabs { flex-direction: row; margin: 16px 0 10px 0; border-bottom-width: 1px; border-color: rgba(255, 255, 255, 0.14); }
.cp .zb.tab { --cut: 0; --fill: rgba(0, 0, 0, 0); --stroke: rgba(0, 0, 0, 0); padding: 10px 18px; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 14px; letter-spacing: 1.96px; opacity: 0.6; border-bottom-width: 3px; border-color: rgba(0, 0, 0, 0); margin-right: 4px; }
.cp .zb.tab:hover { translate: 0 0; opacity: 0.9; --fill: rgba(255, 255, 255, 0.04); }
.cp .zb.tab.on { opacity: 1; border-color: #ffd76a; color: #ffd76a; }
.cp .body { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.cp .body .unity-scroll-view__content-container { padding: 4px 4px 20px 4px; }
.cp > .bar { margin: 0 -40px; }
.cp .h3 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 15px; letter-spacing: 2.1px; margin: 18px 0 10px 0; opacity: 0.85; }
.cp .h3row { flex-direction: row; align-items: center; }
.cp .h3row .h3 { margin-right: 12px; }
.cp .filters { flex-direction: row; align-items: center; margin-bottom: 10px; }
.cp .filters > * { margin-right: 10px; }
.cp .zb.fbtn { padding: 8px 16px; font-size: 14px; }
.cp .zb.fbtn.on { --fill: #ffd76a; color: #1a1206; }
.cp .empty { opacity: 0.6; padding: 20px 0; }
.cp .note { opacity: 0.7; max-width: 900px; }
.cp .dim { opacity: 0.5; }
.cp .strip { flex-direction: row; }
.cp .strip .st { flex-grow: 1; flex-basis: 0; margin-right: 10px; background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 10px 12px; }
.cp .st-b { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 24px; }
.cp .st-s { letter-spacing: 1.68px; opacity: 0.65; font-size: 12px; }
.cp .cols { flex-direction: row; }
.cp .col.l { flex-grow: 1; flex-basis: 0; margin-right: 30px; }
.cp .col.r { flex-grow: 1.2; flex-basis: 0; }
.cp .mbar { flex-direction: row; align-items: center; margin: 5px 0; }
.cp .mb-l { width: 160px; margin-right: 10px; }
.cp .mbar .cbar { flex-grow: 1; }
.cp .mb-v { width: 80px; -unity-text-align: middle-right; opacity: 0.8; margin-left: 10px; }
.cp .cbar { height: 6px; background-color: rgba(255, 255, 255, 0.1); }
.cp .cbar-u { position: absolute; left: 0; top: 0; bottom: 0; background-color: #ffd76a; }
.cp .rolecards { flex-direction: row; }
.cp .rc { flex-grow: 1; flex-basis: 0; align-items: center; background-color: rgba(255, 255, 255, 0.05); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 10px; margin-right: 10px; }
.cp .rc .ri { width: 26px; height: 26px; }
.cp .rc-s { font-size: 14px; opacity: 0.8; }
.cp .zb.top { flex-direction: row; align-items: center; justify-content: flex-start; padding: 6px 8px; --cut: 0; --fill: rgba(0, 0, 0, 0); --stroke: rgba(0, 0, 0, 0); letter-spacing: 0; }
.cp .zb.top:hover { translate: 0 0; --fill: rgba(255, 255, 255, 0.06); }
.cp .top .cimg { margin-right: 12px; background-position-y: top; }
.cp .top-m { flex-grow: 1; }
.cp .top-b { margin-bottom: 4px; }
.cp .top-v { width: 110px; -unity-text-align: middle-right; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; font-size: 16px; margin-left: 12px; }
.cp .herohead { flex-direction: row; align-items: center; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 12px 16px; margin-bottom: 12px; }
.cp .herohead .cimg { margin-right: 16px; background-position-y: top; }
.cp .hh-h3 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 22px; margin-bottom: 4px; }
.cp .hh-row { flex-direction: row; align-items: center; }
.cp .lvl { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 13px; letter-spacing: 1.3px; padding: 3px 10px; border-width: 2px; border-radius: 12px; margin-right: 10px; }
.cp .srs { margin-left: auto; }
.cp .srs-row { flex-direction: row; align-items: center; margin: 2px 0; }
.cp .srs-l { opacity: 0.6; letter-spacing: 1.1px; font-size: 11px; width: 150px; }
.cp .sr { flex-direction: row; align-items: center; -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 16px; }
.cp .sr .sr-t { margin-left: 6px; }
.cp .cards { flex-direction: row; flex-wrap: wrap; }
.cp .scard { width: 32%; min-width: 340px; margin: 0 1% 14px 0; background-color: rgba(255, 255, 255, 0.04); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 10px 14px; }
.cp .scard .h4 { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 13px; letter-spacing: 1.82px; color: #ffd76a; margin-bottom: 6px; }
.cp .ctable { width: 100%; }
.cp .ctr { flex-direction: row; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.05); }
.cp .ctr.th { border-top-width: 0; }
.cp .ctd { flex-grow: 1; flex-basis: 0; padding: 4px 6px; -unity-text-align: middle-right; font-size: 15px; }
.cp .ctd.first { flex-grow: 2.2; -unity-text-align: middle-left; opacity: 0.85; }
.cp .th .ctd { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 11px; letter-spacing: 1.1px; opacity: 0.55; }
.cp .ctd.h { flex-direction: row; align-items: center; justify-content: flex-end; }
.cp .ctd.h .cimg { margin-right: 6px; background-position-y: top; }
.cp .rgrid, .cp .pgrid, .cp .pbig { flex-direction: row; flex-wrap: wrap; }
.cp .zb.rcard, .cp .rcard { width: 150px; margin: 0 10px 10px 0; align-items: center; justify-content: flex-start; background-color: rgba(255, 255, 255, 0.05); --cut: 0; --fill: rgba(255, 255, 255, 0.05); --stroke: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 10px; letter-spacing: 0; }
.cp .zb.rcard:hover { translate: 0 0; }
.cp .rcard.dim { opacity: 0.4; }
.cp .rcard > * { margin-bottom: 3px; }
.cp .rcard .cimg { background-position-y: top; }
.cp .srv { -unity-font: url("Fonts/Orbitron-900.ttf"); -unity-font-definition: initial; font-size: 26px; }
.cp .pips { flex-direction: row; }
.cp .pip { width: 12px; height: 12px; border-width: 1px; border-color: #ffd76a; rotate: 45deg; margin: 2px; }
.cp .pip.on { background-color: #ffd76a; }
.cp .zb.pcard { width: 18.4%; margin: 0 2% 12px 0; align-items: center; justify-content: flex-start; --cut: 0; --fill: rgba(255, 255, 255, 0.05); --stroke: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(255, 255, 255, 0.14); padding: 12px; letter-spacing: 0; }
.cp .zb.pcard:hover { translate: 0 0; }
.cp .pcard > * { margin-bottom: 4px; }
.cp .pcard .ring { border-radius: 52px; padding: 4px; }
.cp .pcard .round { border-radius: 48px; background-position-y: top; }
.cp .pcard .cbar { width: 100%; }
.cp .pc-em { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 18px; }
.cp .pc-s { opacity: 0.7; font-size: 12px; }
.cp .zb.pmini { width: 210px; margin: 0 8px 8px 0; flex-direction: row; justify-content: flex-start; --cut: 0; --fill: rgba(255, 255, 255, 0.04); --stroke: rgba(0, 0, 0, 0); padding: 6px 10px; letter-spacing: 0; }
.cp .zb.pmini:hover { translate: 0 0; }
.cp .pmini .cimg { margin-right: 10px; background-position-y: top; }
.cp .pm-m { flex-grow: 1; }
.cp .pm-s { font-size: 13px; opacity: 0.8; }

/* ---------------- Ult Viewer overlay (UltShowcase.ts injectCss) */
.ultsc { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ultsc .ucol { position: absolute; left: 24px; top: 70px; width: 430px; }
.ultsc .ucard { flex-direction: row; padding: 14px 16px; background-color: rgba(6, 8, 16, 0.72); border-left-width: 4px; margin-bottom: 10px; }
.ultsc .uc-img { width: 78px; height: 78px; border-width: 1px; border-color: rgba(255, 255, 255, 0.2); margin-right: 14px; flex-shrink: 0; }
.ultsc .uc-t { flex-grow: 1; flex-shrink: 1; }
.ultsc .uc-s { letter-spacing: 1.44px; opacity: 0.7; font-size: 12px; }
.ultsc .uc-b { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 22px; margin: 2px 0 4px 0; }
.ultsc .uc-p { font-size: 14px; color: #d5dcf5; }
.ultsc .ubar { margin-top: 8px; height: 4px; background-color: rgba(255, 255, 255, 0.12); }
.ultsc .ubar-i { height: 100%; width: 100%; transition-property: width; transition-duration: 0.1s; transition-timing-function: linear; }
.ultsc .ubtns { flex-direction: row; flex-wrap: wrap; }
.ultsc .zb.ub { --cut: 0; --fill: rgba(6, 8, 16, 0.78); --stroke: rgba(0, 0, 0, 0); border-width: 1px; border-color: rgba(255, 255, 255, 0.25); padding: 8px 12px; font-size: 16px; letter-spacing: 0.96px; margin: 0 8px 8px 0; }
.ultsc .zb.ub:hover, .ultsc .zb.ub.on { translate: 0 0; border-color: #ffd76a; color: #ffd76a; }
.ultsc .upick { position: absolute; left: 50%; bottom: 22px; translate: -50% 0; flex-direction: row; padding: 6px; background-color: rgba(6, 8, 16, 0.6); }
.ultsc .zb.up { width: 48px; height: 48px; padding: 0; margin: 0 3px; --cut: 0; --fill: #111; --stroke: rgba(0, 0, 0, 0); border-width: 2px; border-color: rgba(0, 0, 0, 0); }
.ultsc .zb.up:hover { translate: 0 0; border-color: rgba(255, 255, 255, 0.5); }
.ultsc .up-img { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.ultsc .uhint { position: absolute; left: 50%; bottom: 80px; translate: -50% 0; font-size: 12px; opacity: 0.55; letter-spacing: 0.96px; }
.hud.ultsc-on .obj { display: none; }

/* ---------------- story cinematics + boss title cards (Cinematic.ts) */
.cine-panel { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #000; overflow: hidden; }
.cine-img { position: absolute; left: -5%; top: -5%; right: -5%; bottom: -5%; background-size: cover; }
.cine-bar { position: absolute; left: 0; right: 0; height: 9%; background-color: #000; }
.cine-bar.top { top: 0; }
.cine-bar.bot { bottom: 0; }
.cine-cap { position: absolute; left: 8%; right: 8%; bottom: 13%; -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; font-size: 30px; color: #fff; text-shadow: 0 3px 14px #000; }
.cine-skip { position: absolute; right: 3%; bottom: 3%; -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 14px; color: rgba(255, 255, 255, 0.53); letter-spacing: 2.1px; }
.cine-fade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #000; opacity: 0; transition-property: opacity; transition-duration: 0.6s; }
.cine-fade.on { opacity: 1; }
.cine-boss { position: absolute; left: 0; right: 0; top: 22%; align-items: center; }
.cine-boss .cb-s { -unity-font: url("Fonts/Rajdhani-700.ttf"); -unity-font-definition: initial; font-size: 16px; letter-spacing: 9.6px; color: #fff; -unity-text-align: upper-center; }
.cine-boss .cb-b { -unity-font: url("Fonts/Orbitron-800.ttf"); -unity-font-definition: initial; font-size: 96px; text-shadow: 0 0 30px rgba(255, 255, 255, 0.4); -unity-text-align: upper-center; }
.cine-boss .cb-t { -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 20px; color: #eee; letter-spacing: 5px; -unity-text-align: upper-center; }
.cine-boss .cb-w { -unity-font: url("Fonts/Rajdhani-600.ttf"); -unity-font-definition: initial; font-size: 16px; color: #ffd76a; margin-top: 8px; -unity-text-align: upper-center; }
