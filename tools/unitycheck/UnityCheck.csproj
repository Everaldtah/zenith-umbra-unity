<!-- Headless COMPILE check of Unity-side runtime code (Assets/ZU/Game, Assets/ZU/Dynamics, staging/...) against the
     editor's own UnityEngine module DLLs and the project's compiled package assemblies - no editor needed, so it can run
     while the editor is busy. Compile only (nothing here can run Unity). Run build.ps1 next to this file. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS0649;CS0414;CS0169;CS0618</NoWarn>
    <UnityManaged>C:\Program Files\Unity\Hub\Editor\6000.6.4f1\Editor\Data\Managed</UnityManaged>
    <ProjectRoot>$(MSBuildThisFileDirectory)..\..</ProjectRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProjectRoot)\Assets\ZU\Sim\**\*.cs" />
    <Compile Include="$(ProjectRoot)\Assets\ZU\Game\**\*.cs" />
    <Compile Include="$(ProjectRoot)\Assets\ZU\Dynamics\**\*.cs" />
    <!-- work in progress outside Assets (Unity never sees it); test harnesses under staging/*/tests are not part of it -->
    <Compile Include="$(ProjectRoot)\staging\*\Runtime\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="$(UnityManaged)\UnityEngine\UnityEngine*.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.Burst.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.Collections.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.InputSystem.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.RenderPipelines.Core.Runtime.dll" Private="false" />
    <Reference Include="$(ProjectRoot)\Library\ScriptAssemblies\Unity.RenderPipelines.Universal.Runtime.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
